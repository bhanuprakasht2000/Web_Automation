<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Suite">

  <test thread-count="5" name="Test1">
    <groups>
  <define name="dailybuild">
  <include name="Smoke"/>
  </define>
  <define name="weeklybuild">
  <include name="Sanity"/>
  </define>
<run>
<include name="dailybuild"/>
</run>
</groups>
    <classes>
      <class name="Demo.Login" />
      <class name="Demo.Register"/>
      <class name="Demo.Search"/>
    </classes>
  </test> <!-- Test -->
  
  <!-- 2nd test for checking the groups attribute at the testlevel-->
  <test thread-count="5" name="Test2">
    <groups>
  <define name="monthbuild">
  <include name="Search"/>
  </define>
  <define name="weeklybuild">
  <include name="Sanity"/>
  </define>
<run>
<include name="monthbuild"/>
</run>
</groups>
    <classes>
<class name="Demo.Login" />
      <class name="Demo.Register"/>
      <class name="Demo.Search"/>    
      </classes>
  </test> 
</suite> <!-- Suite -->
