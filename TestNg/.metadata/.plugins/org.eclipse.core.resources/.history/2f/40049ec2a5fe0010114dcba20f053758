package Retryfailedtests;

import org.testng.IRetryAnalyzer;
import org.testng.ITestResult;

public class RetryAnanlyser implements IRetryAnalyzer{
	int count=0;
	int endpoint = 3;
	@Override
	public boolean retry(ITestResult result) {
	
		if(count<endpoint) {
			count++;
			return true;
		}
		return false;
	}

}
