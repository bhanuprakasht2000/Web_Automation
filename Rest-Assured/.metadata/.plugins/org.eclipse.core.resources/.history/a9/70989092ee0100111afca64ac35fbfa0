	@Test
public void addproductusingJSONAsString() {
	String Jsonrequestbodyasstring="{\"title\": \"Laptop product\",\"price\": 13.9}";	
	//Way 1
	RestAssured.baseURI="https://fakestoreapi.com/products";
	RequestSpecification reqspec=RestAssured.given();
	reqspec.contentType(ContentType.JSON);
	reqspec.body(Jsonrequestbodyasstring);
	Response response=reqspec.post();
	System.out.println(response.getStatusCode());
	System.out.println(response.getBody().asPrettyString());
	//Way2
	RestAssured.given()
	.contentType(ContentType.JSON)
	.body(Jsonrequestbodyasstring)
	.post("https://fakestoreapi.com/products")
	.then().log().all();
}
